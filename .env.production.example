# Production environment configuration
# Copy to .env and customize for your deployment

# ── Core ──────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_URL=https://your-domain.example
DATABASE_PATH=/app/data/workflows.db
LOG_LEVEL=INFO
DEPLOYMENT_PROFILE=enterprise

# ── Ollama ────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_STRONG=qwen2.5:14b

# ── Distributed runtime ───────────────────────────────
ENABLE_DISTRIBUTED_RUNTIME=1
REDIS_URL=redis://redis:6379/0
POSTGRES_URL=postgresql://operator:changeme@postgres:5432/operator
MAX_WORKER_CONCURRENCY=8
WORKER_HEARTBEAT_SECONDS=30

# ── Enterprise auth ───────────────────────────────────
ENABLE_RBAC=1
ENABLE_MULTI_TENANCY=1
JWT_SECRET=replace-with-at-least-32-character-secret-value

# ── Enterprise infrastructure phase 2 ─────────────────
ENABLE_RUNTIME_MESH=1
ENABLE_POLICY_ENGINE=1
ENABLE_COST_METERING=1
ENABLE_INFRA_INTELLIGENCE=1
ENABLE_AUTOSCALING=1
ENABLE_APPROVAL_WORKFLOWS=1
COMPLIANCE_MODE=enterprise
DEFAULT_EXECUTION_BUDGET=500
RUNTIME_MESH_NODE_ID=node-1

# ── Observability ─────────────────────────────────────
ENABLE_OTEL_TRACING=1

# ── Intelligence / Computer Use ───────────────────────
ENABLE_VECTOR_MEMORY=1
ENABLE_COMPUTER_USE=1
COMPUTER_USE_HEADLESS=1
MAX_EXECUTION_DURATION_SECONDS=3600
MEMORY_RETENTION_DAYS=30
