# Backend
BACKEND_PORT=8000
OLLAMA_URL=http://host.docker.internal:11434
DATABASE_PATH=/app/data/workflows.db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MODEL_LIGHT=qwen2.5:3b
OLLAMA_MODEL_STRONG=qwen2.5:7b

# Persistent intelligence layer
ENABLE_VECTOR_MEMORY=1
EMBEDDING_MODEL=nomic-embed-text
MAX_LONG_TERM_MEMORIES=5000
WORLD_MODEL_CONFIDENCE_THRESHOLD=0.3

# Production readiness
MEMORY_RETENTION_DAYS=30
MEMORY_MAX_SHARED_KB=256
MAX_EXECUTION_DURATION_SECONDS=3600

# Computer Use / Multimodal Desktop
ENABLE_COMPUTER_USE=1
COMPUTER_USE_HEADLESS=1
OCR_ENGINE=tesseract
MAX_SCREENSHOT_HISTORY=50
UI_ACTION_TIMEOUT_SECONDS=120
COMPUTER_USE_MAX_ACTIONS_PER_MINUTE=60

# Distributed runtime / production infrastructure
ENABLE_DISTRIBUTED_RUNTIME=0
REDIS_URL=
POSTGRES_URL=
ENABLE_RBAC=0
ENABLE_MULTI_TENANCY=0
ENABLE_OTEL_TRACING=0
MAX_WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_SECONDS=30
JWT_SECRET=

# Enterprise infrastructure phase 2
ENABLE_RUNTIME_MESH=0
ENABLE_POLICY_ENGINE=0
ENABLE_COST_METERING=0
ENABLE_INFRA_INTELLIGENCE=0
ENABLE_AUTOSCALING=0
ENABLE_APPROVAL_WORKFLOWS=0
COMPLIANCE_MODE=local_dev
DEFAULT_EXECUTION_BUDGET=100.0
RUNTIME_MESH_NODE_ID=local

# Bounded self-improvement (optional — no source-code mutation)
ENABLE_SELF_IMPROVEMENT=0
ENABLE_PROMPT_EVOLUTION=0
ENABLE_BENCHMARK_OPTIMIZATION=0
ENABLE_RUNTIME_ADAPTATION=0
MAX_HEURISTIC_MUTATIONS_PER_DAY=50
MAX_PROMPT_VARIANTS=20
SELF_IMPROVEMENT_CONFIDENCE_THRESHOLD=0.75
SELF_IMPROVEMENT_DRY_RUN=1

# Recursive intelligence / Phase 2 (bounded self-evolution — no source-code mutation)
ENABLE_META_REFLECTION=0
ENABLE_CAPABILITY_DISCOVERY=0
ENABLE_ADVERSARIAL_BENCHMARKING=0
ENABLE_COORDINATION_EVOLUTION=0
ENABLE_PREDICTIVE_RUNTIME=0
MAX_RECURSIVE_REFLECTION_DEPTH=2
MAX_AUTONOMOUS_EVOLUTION_CYCLES_PER_DAY=20
SELF_EVOLUTION_KILL_SWITCH=0
UNSAFE_EMERGENCE_THRESHOLD=0.92